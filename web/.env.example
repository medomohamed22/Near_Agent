# CarPass runs on NEAR testnet only. Copy to .env.local for local work;
# on Vercel set these under Project Settings -> Environment Variables.

# NEXT_PUBLIC_CONTRACT_ID=carpass-v5.testnet   (the default; set it only to point at your own deployment)
# NEXT_PUBLIC_RPC_URL=https://rpc.testnet.fastnear.com

# Guest mode: private keys of the four demo accounts (testnet only, from scripts/.keys.json).
DEMO_SELLER_KEY=
DEMO_BUYER_KEY=
DEMO_WORKSHOP_KEY=
DEMO_ADMIN_KEY=

# Document storage and shared rate limits (Supabase; schema in supabase/migrations).
# The password belongs to the server account that row-level security allows to
# read and write documents.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVER_PASSWORD=

# AI: Meta Model API (OpenAI-compatible). Without a key the app labels itself
# "AI on fallback" and uses stored sample readings or manual entry.
META_MODEL_API_KEY=
# META_MODEL=muse-spark-1.3-contributor
# META_MODEL_API_BASE=https://api.meta.ai/v1
# Daily caps on paid AI calls (UTC day): per client address, and for the whole site.
# AI_DAILY_PER_IP=20
# AI_DAILY_TOTAL=250
